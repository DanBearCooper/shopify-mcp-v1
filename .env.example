# ════════════════════════════════════════════════════════
#  Polymarket Auto Bot — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit your .env to source control.
# ════════════════════════════════════════════════════════

# ── Authentication ───────────────────────────────────────
# Your Ethereum/Polygon private key (hex, with or without 0x prefix)
# This wallet must hold USDC on Polygon and be approved in Polymarket.
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# L2 API credentials — leave blank to auto-derive from private key on first run
# (derived creds will be printed to the log; copy them here for subsequent runs)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Network ──────────────────────────────────────────────
# 137 = Polygon mainnet (production) | 80002 = Amoy testnet
CHAIN_ID=137
CLOB_URL=https://clob.polymarket.com
GAMMA_URL=https://gamma-api.polymarket.com

# ── Strategy ─────────────────────────────────────────────
# arbitrage | momentum | market_making | value
STRATEGY=arbitrage

# ── Safety: always start in dry-run mode ─────────────────
# Set DRY_RUN=false only after reviewing the logs in dry mode!
DRY_RUN=true

# ── Risk Management ──────────────────────────────────────
MAX_POSITION_USDC=50.0          # max USDC exposed per single market
MAX_TOTAL_EXPOSURE_USDC=500.0   # max USDC exposed across all markets
DAILY_LOSS_LIMIT_USDC=100.0     # halt bot if daily loss exceeds this
MAX_DRAWDOWN_PCT=0.15           # halt bot if drawdown exceeds 15%

# ── Market Selection ─────────────────────────────────────
MIN_VOLUME_24H=10000.0          # skip markets with <10k USDC 24h volume
MIN_LIQUIDITY=1000.0            # minimum orderbook depth
# CATEGORIES=politics,crypto    # comma-separated tag filter (blank = all)
CATEGORIES=

# ── Bot Behavior ─────────────────────────────────────────
POLL_INTERVAL=30                # seconds between trading cycles
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=polymarket_bot.log     # set to empty string to log only to console

# ── Market-Making Parameters ─────────────────────────────
MM_SPREAD_PCT=0.02              # target bid-ask spread (2%)
MM_ORDER_SIZE_USDC=10.0         # size of each resting quote
MM_MAX_INVENTORY_USDC=200.0     # stop quoting if inventory exceeds this
MM_STALE_ORDER_SECONDS=120      # cancel quotes older than this

# ── Arbitrage Parameters ──────────────────────────────────
ARB_MIN_PROFIT_PCT=0.02         # minimum net edge required (2%)
ARB_MAX_SLIPPAGE=0.01           # max acceptable slippage (1%)

# ── Momentum Parameters ───────────────────────────────────
MOMENTUM_LOOKBACK=10            # number of candles to look back
MOMENTUM_THRESHOLD=0.05         # minimum price change to trigger (5%)
